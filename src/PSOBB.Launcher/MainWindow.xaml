<Window x:Class="PSOBB.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSOBB Control Center"
        Width="1080"
        Height="790"
        MinWidth="940"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontSize="25" FontWeight="SemiBold" Text="PSOBB Control Center" />
        <TextBlock Margin="0,4,0,0"
                   Foreground="#555"
                   Text="Script-managed local server and client lifecycle. Credentials are never collected or accepted as arguments." />
      </StackPanel>
      <Border Grid.Column="1" Padding="14,8" Background="#E8EEF6" CornerRadius="4">
        <StackPanel Orientation="Horizontal">
          <TextBlock Margin="0,0,8,0" FontWeight="SemiBold" Text="State" />
          <TextBlock Text="{Binding LifecycleStateText}" />
        </StackPanel>
      </Border>
    </Grid>

    <GroupBox Grid.Row="1" Header="Release verification" Margin="0,0,0,12" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="135" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Release manifest" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ManifestPath, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Command="{Binding BrowseManifestCommand}" Content="Browse..." />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,9,0,0" VerticalAlignment="Center" Text="Runtime root" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,9,0,0" Text="{Binding RuntimeRoot, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="1" Grid.Column="2" Margin="8,9,0,0" Command="{Binding BrowseRuntimeCommand}" Content="Browse..." />

        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Orientation="Horizontal">
          <Button Command="{Binding LoadManifestCommand}" Content="Load manifest" />
          <Button Command="{Binding VerifyCommand}" Content="Verify files" />
          <Button Command="{Binding RepairCommand}" Content="Verify / repair client" />
          <TextBlock VerticalAlignment="Center" Foreground="#333" Text="{Binding ManifestSummary}" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="2" Header="Launch profile" Margin="0,0,0,12" Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="250" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Channel" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" />
        <TextBlock Grid.Column="2" Margin="18,0,8,0" VerticalAlignment="Center" Text="Profile" />
        <ComboBox Grid.Column="3" ItemsSource="{Binding GraphicsProfiles}" SelectedItem="{Binding SelectedGraphicsProfile}" />
        <TextBlock Grid.Column="4" Margin="18,0,8,0" VerticalAlignment="Center" Text="Monitor" />
        <ComboBox Grid.Column="5" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" />
        <TextBlock Grid.Column="6" Margin="18,0,8,0" VerticalAlignment="Center" Text="Window" />
        <ComboBox Grid.Column="7" ItemsSource="{Binding WindowModes}" SelectedItem="{Binding SelectedWindowMode}" />
        <CheckBox Grid.Column="8" Margin="18,0,0,0" VerticalAlignment="Center" IsChecked="{Binding SafeMode}" Content="Safe mode" />
        <CheckBox Grid.Row="1"
                  Grid.Column="1"
                  Grid.ColumnSpan="8"
                  Margin="0,10,0,0"
                  VerticalAlignment="Center"
                  IsChecked="{Binding PreserveForeground}"
                  Content="Try to keep current app focused" />
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="3" Header="Lifecycle" Margin="0,0,0,12" Padding="12">
      <WrapPanel>
        <Button Command="{Binding StartSessionCommand}" Content="Start session" />
        <Button Command="{Binding StartServerCommand}" Content="Start server" />
        <Button Command="{Binding StartClientCommand}" Content="Start client" />
        <Button Command="{Binding StopClientCommand}" Content="Stop client" />
        <Button Command="{Binding StopServerCommand}" Content="Stop server" />
        <Button Command="{Binding StopAllCommand}" Content="Stop all" />
        <Button Command="{Binding RefreshStateCommand}" Content="Refresh state" />
        <Button Command="{Binding ExportDiagnosticsCommand}" Content="Export diagnostic" />
      </WrapPanel>
    </GroupBox>

    <GroupBox Grid.Row="4" Header="Verification" Padding="12">
      <TextBox AcceptsReturn="True"
               IsReadOnly="True"
               FontFamily="Consolas"
               HorizontalScrollBarVisibility="Auto"
               VerticalScrollBarVisibility="Auto"
               Text="{Binding VerificationSummary, Mode=OneWay}" />
    </GroupBox>

    <Border Grid.Row="5" Margin="0,14,0,0" Padding="10,7" Background="#F3F5F7" CornerRadius="4">
      <TextBlock VerticalAlignment="Center" Text="{Binding Status}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
