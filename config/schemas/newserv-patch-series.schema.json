{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psobb.local/schemas/newserv-patch-series.schema.json",
  "title": "PSOBB ordered newserv patch series",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "sourceCommit",
    "buildEnvironment",
    "patches"
  ],
  "properties": {
    "$schema": {
      "const": "https://psobb.local/schemas/newserv-patch-series.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "sourceCommit": {
      "const": "d754a34e271a4fb387be63db34ef0c303e49dcf2"
    },
    "buildEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["NEWSERV_BUILD_REVISION", "SOURCE_DATE_EPOCH"],
      "properties": {
        "NEWSERV_BUILD_REVISION": { "const": "d754a34" },
        "SOURCE_DATE_EPOCH": { "const": "1783778777" }
      }
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order",
            "path",
            "sha256",
            "scope",
            "runtimeBehaviorChanged"
          ],
          "properties": {
            "order": { "const": 1 },
            "path": { "const": "0001-deterministic-revision-metadata.patch" },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "scope": { "const": "build-metadata" },
            "runtimeBehaviorChanged": { "const": false }
          }
        }
      ],
      "items": false
    }
  }
}
