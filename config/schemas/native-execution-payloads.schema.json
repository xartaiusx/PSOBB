{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psobb.local/schemas/native-execution-payloads.schema.json",
  "title": "PSOBB native execution payload manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "manifestId",
    "generatedAtUtc",
    "extensions",
    "ordinaryFileTrees",
    "payloads"
  ],
  "properties": {
    "$schema": { "const": "./schemas/native-execution-payloads.schema.json" },
    "schemaVersion": { "const": 1 },
    "manifestId": { "const": "combat-canary-native-execution-payloads" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "extensions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "prefixItems": [
        { "const": ".bat" },
        { "const": ".cmd" },
        { "const": ".com" },
        { "const": ".dll" },
        { "const": ".exe" },
        { "const": ".pyd" }
      ],
      "items": false
    },
    "ordinaryFileTrees": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/tree" }, { "properties": { "id": { "const": "cmake" } }, "required": ["id"] }] },
        { "allOf": [{ "$ref": "#/$defs/tree" }, { "properties": { "id": { "const": "git-for-windows" } }, "required": ["id"] }] },
        { "allOf": [{ "$ref": "#/$defs/tree" }, { "properties": { "id": { "const": "gnupg" } }, "required": ["id"] }] },
        { "allOf": [{ "$ref": "#/$defs/tree" }, { "properties": { "id": { "const": "ninja" } }, "required": ["id"] }] },
        { "allOf": [{ "$ref": "#/$defs/tree" }, { "properties": { "id": { "const": "winlibs" } }, "required": ["id"] }] }
      ],
      "items": false
    },
    "payloads": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/payload" }, { "properties": { "id": { "const": "cmake" } }, "required": ["id"] }] },
        { "allOf": [{ "$ref": "#/$defs/payload" }, { "properties": { "id": { "const": "git-for-windows" } }, "required": ["id"] }] },
        { "allOf": [{ "$ref": "#/$defs/payload" }, { "properties": { "id": { "const": "gnupg" } }, "required": ["id"] }] },
        { "allOf": [{ "$ref": "#/$defs/payload" }, { "properties": { "id": { "const": "ninja" } }, "required": ["id"] }] },
        { "allOf": [{ "$ref": "#/$defs/payload" }, { "properties": { "id": { "const": "winlibs" } }, "required": ["id"] }] }
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\/:][^\\\\:]*$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pathRoot",
        "relativeRoot",
        "fileCount",
        "totalBytes",
        "rootSha256"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pathRoot": { "enum": ["LOCALAPPDATA", "PROGRAMFILES"] },
        "relativeRoot": { "$ref": "#/$defs/relativePath" },
        "fileCount": { "type": "integer", "minimum": 1 },
        "totalBytes": { "type": "integer", "minimum": 1 },
        "rootSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pathRoot", "relativeRoot", "fileCount", "totalBytes", "files"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pathRoot": { "enum": ["LOCALAPPDATA", "PROGRAMFILES"] },
        "relativeRoot": { "$ref": "#/$defs/relativePath" },
        "fileCount": { "type": "integer", "minimum": 1 },
        "totalBytes": { "type": "integer", "minimum": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    }
  }
}
